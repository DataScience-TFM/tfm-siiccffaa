# Configuración local del proyecto.
# La ruta es relativa a la carpeta raíz del proyecto para que funcione
# independientemente del usuario de Windows y de la unidad donde se copie.
#
# Antes de ejecutar, coloque el archivo de credenciales de la cuenta de servicio
# dentro de la carpeta "credentials" con este nombre, o cambie únicamente el valor inferior.
# No publique ni comparta este archivo si contiene una ruta o secreto real.
GOOGLE_APPLICATION_CREDENTIALS=credentials/tfm-evaluacion-api.key
